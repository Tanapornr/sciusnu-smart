# ================================================================
# Vercel Environment Variables
# Add ALL of these in: Vercel Dashboard → Project → Settings → Environment Variables
# ================================================================

# ── JWT Authentication ───────────────────────────────────────────
JWT_SECRET=your-secret-here-must-be-at-least-32-chars-long
JWT_EXPIRES_IN=8h

# ── Admin credentials ────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password

# ── Google Sheets (read via Service Account) ─────────────────────
SPREADSHEET_ID=your-google-sheet-id
GS_MAIN_TABLE_NAME=your-google-spreadsheet-main-table-name
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ── Apps Script relay (writes + Drive) ───────────────────────────
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
APPS_SCRIPT_SECRET=your-apps-script-shared-secret

# ── Mail relay ───────────────────────────────────────────────────
MAIL_RELAY_URL=https://script.google.com/macros/s/YOUR_MAIL_RELAY_ID/exec
MAIL_RELAY_SECRET=your-mail-relay-secret

# ── Drive upload ─────────────────────────────────────────────────
DRIVE_FOLDER_ID=your-google-drive-folder-id
UPLOAD_TOKEN_SECRET=your-upload-token-secret-min-32-chars
SIGNATURE_KEY=your-signature-encryption-key

# ── Admin emails (comma-separated) ──────────────────────────────
ADMIN_EMAILS=admin@example.com,admin2@example.com

# ── Web URL (used in emails) ─────────────────────────────────────
WEB_URL=https://your-project.vercel.app/
